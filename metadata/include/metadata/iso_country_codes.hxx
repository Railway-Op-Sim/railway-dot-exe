inline const std::string get_name(const std::string& code) {
	for(const auto& [country, c] : country_codes) {
		if(code == c) return country;
	}
	throw std::invalid_argument("Invalid country code '" + code + "'");
}

inline const std::string get_code(const std::string& name) {
	if(country_codes.find(name) == country_codes.end()) {
		throw std::invalid_argument("Invalid country '" + name + "'");
	}
	return country_codes.at(name);
}
