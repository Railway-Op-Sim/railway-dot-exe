  object ErrorMessage: TMemo
    Left = 312
    Top = 144
    Width = 361
    Height = 430
    Lines.Strings = (
      
        '                                          ***  ERROR DETECTED **' +
        '*'
      ''
      
        'The program has detected a serious error and must close.  Are yo' +
        'u using'
      
        'the latest program version?  If not please download it and try a' +
        'gain as'
      'the error might already have been corrected.'
      ''
      
        'If you are using the latest version then PLEASE DO NOT RESTART T' +
        'HE'
      'PROGRAM UNTIL THE ERROR FILE "errorlog.err" HAS BEEN EMAILED'
      
        'TO ME AT THE ADDRESS BELOW.  This file will be found in the prog' +
        'ram'
      
        'file'#39's default folder (i.e. where RailOS32.exe or RailOS64.exe r' +
        'esides).'
      ''
      
        'If you can'#39't email it immediately then please copy it to another' +
        ' folder and'
      'keep it safe.  IF THE PROGRAM IS RESTARTED THE FILE MAY BE'
      'OVERWRITTEN AND THE DATA THAT IT CONTAINS LOST.'
      ''
      'My email address:  railwayfeedback@gmail.com'
      ''
      
        'The file contains details of the railway that was loaded, togeth' +
        'er with'
      
        'a list of program events preceding the error.  There is no infor' +
        'mation in'
      
        'it about your computer or anything other than the railway itself' +
        ' and its'
      
        'operation.  It is readable using any word processor or text edit' +
        'or.'
      ''
      
        'If you are able to send a brief description of the circumstances' +
        ' and'
      
        'actions immediately prior to the error occurring then that would' +
        ' be helpful,'
      'but the error file is the main thing, please send that.'
      ''
      
        'This will help considerably in correcting the problem and improv' +
        'ing the'
      'program.'
      ''
      '                                           ***  MANY THANKS ***'
      ''
      'Albert Ball')
    ReadOnly = True
    TabOrder = 12
  end
